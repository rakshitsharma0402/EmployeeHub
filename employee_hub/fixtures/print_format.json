  "html": "<div style=\"width: 340px; padding: 16px; border: 2px solid #2c3e50; border-radius: 10px; font-family: Arial, sans-serif; background: #f9fafb;\">\n\t<div style=\"text-align: center; border-bottom: 1px solid #ccc; padding-bottom: 8px; margin-bottom: 10px;\">\n\t\t<strong style=\"font-size: 14px; color: #2c3e50;\">EMPLOYEE HUB</strong><br>\n\t\t<span style=\"font-size: 10px; color: #666;\">Identity Card</span>\n\t</div>\n\n\t<div style=\"text-align: center; margin-bottom: 10px;\">\n\t\t{% if doc.profile_photo %}\n\t\t\t<img src=\"{{ doc.profile_photo }}\" style=\"width: 90px; height: 90px; object-fit: cover; border-radius: 50%; border: 2px solid #2c3e50;\">\n\t\t{% else %}\n\t\t\t<div style=\"width: 90px; height: 90px; border-radius: 50%; background: #ddd; margin: 0 auto; display: flex; align-items: center; justify-content: center; font-size: 28px; color: #888;\">\n\t\t\t\t{{ doc.first_name[0] }}{{ doc.last_name[0] }}\n\t\t\t</div>\n\t\t{% endif %}\n\t</div>\n\n\t<div style=\"text-align: center; margin-bottom: 10px;\">\n\t\t<strong style=\"font-size: 16px;\">{{ doc.full_name }}</strong><br>\n\t\t<span style=\"font-size: 11px; color: #666;\">{{ doc.designation }}</span>\n\t</div>\n\n\t<table style=\"width: 100%; font-size: 11px; border-collapse: collapse;\">\n\t\t<tr>\n\t\t\t<td style=\"padding: 3px 0; color: #666;\">Employee ID</td>\n\t\t\t<td style=\"padding: 3px 0; text-align: right; font-weight: bold;\">{{ doc.name }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"padding: 3px 0; color: #666;\">Department</td>\n\t\t\t<td style=\"padding: 3px 0; text-align: right;\">{{ doc.department }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"padding: 3px 0; color: #666;\">Date of Joining</td>\n\t\t\t<td style=\"padding: 3px 0; text-align: right;\">{{ doc.date_of_joining }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"padding: 3px 0; color: #666;\">Email</td>\n\t\t\t<td style=\"padding: 3px 0; text-align: right;\">{{ doc.employee_email }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"padding: 3px 0; color: #666;\">Phone</td>\n\t\t\t<td style=\"padding: 3px 0; text-align: right;\">{{ doc.phone or \"-\" }}</td>\n\t\t</tr>\n\t</table>\n</div>",
